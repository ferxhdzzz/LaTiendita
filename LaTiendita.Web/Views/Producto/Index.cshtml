@model IEnumerable<LaTiendita.Domain.Entities.Producto>
@{
    ViewData["Title"] = "Productos";
    var categorias = ViewBag.Categorias as IEnumerable<LaTiendita.Domain.Entities.Categoria> ?? new List<LaTiendita.Domain.Entities.Categoria>();
    string existenciaActual = ViewBag.Existencia as string ?? "";
    int categoriaSeleccionada = ViewBag.CategoriaId != null ? (int)ViewBag.CategoriaId : 0;
}

@Html.AntiForgeryToken()

<style>
    .pill-status { padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; display: inline-block; }
    .status-suficiente { background: #E4EFE3; color: #3C6E47; }
    .status-bajo { background: #F7ECD8; color: #B4791E; }
    .status-agotado { background: #F5E1DA; color: #A8432B; }

    .stock-bar-wrap { display: inline-flex; align-items: center; gap: 8px; }
    .stock-bar-track { width: 60px; height: 5px; background: #EAEAEA; border-radius: 3px; overflow: hidden; }
    .stock-bar-fill { height: 100%; border-radius: 3px; }

    .modal-overlay-custom {
        position: fixed; inset: 0; background: rgba(31, 58, 46, 0.5);
        display: none; align-items: center; justify-content: center; z-index: 9999;
    }
    .modal-box-custom {
        background: #fff; width: 100%; max-width: 520px; border-radius: var(--radius-m);
        padding: 30px; box-shadow: 0 20px 50px rgba(0,0,0,0.3);
    }
</style>

<div style="max-width: 1100px; margin: 0 auto;">

    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
        <div>
            <h1 style="font-size: 2rem;">Productos</h1>
            <p style="color: var(--ink-soft); margin-top: 4px;">
                <span id="contadorProductos">@Model.Count()</span> productos en el catálogo
            </p>
        </div>
        @if (User.IsInRole("Administrador"))
        {
            <button type="button" class="btn-primary-custom" onclick="abrirModalNuevo()" 
                    style="background: var(--ink); color: #fff; padding: 10px 22px; border-radius: var(--radius-s); cursor: pointer;">
                Agregar producto
            </button>
        }
    </div>

    <div class="card-box" style="border: 1px solid var(--border); border-radius: var(--radius-l); padding: 24px 28px;">

        <form method="get" style="display: grid; grid-template-columns: 2fr 1.5fr 1.5fr auto; gap: 14px; margin-bottom: 24px; align-items: center;">
            <input type="text" name="buscar" value="@ViewBag.Buscar" placeholder="Buscar por nombre o código" class="form-control-custom" />

            <select name="categoriaId" class="form-control-custom">
                <option value="">Todas las categorías</option>
                @foreach (var cat in categorias)
                {
                    if (categoriaSeleccionada == cat.Id)
                    {
                        <option value="@cat.Id" selected>@cat.Nombre</option>
                    }
                    else
                    {
                        <option value="@cat.Id">@cat.Nombre</option>
                    }
                }
            </select>

            <select name="existencia" class="form-control-custom">
                @if (string.IsNullOrEmpty(existenciaActual))
                {
                    <option value="" selected>Cualquier existencia</option>
                }
                else
                {
                    <option value="">Cualquier existencia</option>
                }

                @if (existenciaActual == "suficiente")
                {
                    <option value="suficiente" selected>Suficiente</option>
                }
                else
                {
                    <option value="suficiente">Suficiente</option>
                }

                @if (existenciaActual == "bajo")
                {
                    <option value="bajo" selected>Por agotarse</option>
                }
                else
                {
                    <option value="bajo">Por agotarse</option>
                }

                @if (existenciaActual == "agotado")
                {
                    <option value="agotado" selected>Agotado</option>
                }
                else
                {
                    <option value="agotado">Agotado</option>
                }
            </select>

            <button type="submit" class="btn-action" style="padding: 10px 16px; font-weight: 600;">Filtrar</button>
        </form>

        <table class="table-custom">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    <th>Existencia</th>
                    <th>Estado</th>
                    <th style="text-align: right;">Acciones</th>
                </tr>
            </thead>
            <tbody id="tbodyProductos">
                @if (!Model.Any())
                {
                    <tr id="filaSinProductos">
                        <td colspan="7" style="text-align: center; color: var(--ink-faint); padding: 40px;">
                            No se encontraron productos con los filtros seleccionados.
                        </td>
                    </tr>
                }
                @foreach (var p in Model)
                {
                    string estadoTexto;
                    string estadoClase;
                    string barraColor;
                    double porcentaje = p.StockMinimo > 0 ? Math.Min(100, (p.Stock * 100.0) / (p.StockMinimo * 2.5)) : 100;

                    if (p.Stock == 0)
                    {
                        estadoTexto = "Agotado";
                        estadoClase = "status-agotado";
                        barraColor = "var(--danger)";
                        porcentaje = 0;
                    }
                    else if (p.Stock <= p.StockMinimo)
                    {
                        estadoTexto = "Por agotarse";
                        estadoClase = "status-bajo";
                        barraColor = "var(--warning)";
                    }
                    else
                    {
                        estadoTexto = "Suficiente";
                        estadoClase = "status-suficiente";
                        barraColor = "var(--success)";
                    }

                    <tr id="fila-prod-@p.Id" style="transition: all 0.3s ease;">
                        <td style="color: var(--ink-soft); font-size: 0.85rem;">P-@p.Id.ToString("D4")</td>
                        <td style="font-weight: 500;">@p.Nombre</td>
                        <td>@(p.Categoria?.Nombre ?? "General")</td>
                        <td style="font-weight: 600;">$@p.Precio.ToString("N2")</td>
                        <td>
                            <div class="stock-bar-wrap">
                                <span>@p.Stock <span style="color: var(--ink-faint); font-size: 0.8rem;">/ mín. @p.StockMinimo</span></span>
                                <div class="stock-bar-track">
                                    <div class="stock-bar-fill" style="width: @porcentaje%; background: @barraColor;"></div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="pill-status @estadoClase">@estadoTexto</span>
                        </td>
                        <td style="text-align: right;">
                            <div style="display: inline-flex; gap: 6px;">
                                @if (User.IsInRole("Administrador"))
                                {
                                    <button type="button" class="btn-action" 
                                            data-id="@p.Id"
                                            data-nombre="@p.Nombre"
                                            data-catid="@p.CategoriaId"
                                            data-provid="@(p.ProveedorId?.ToString() ?? "")"
                                            data-costo="@p.Costo.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-precio="@p.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-stock="@p.Stock"
                                            data-stockmin="@p.StockMinimo"
                                            onclick="abrirModalEditar(this)">
                                        Editar
                                    </button>

                                    <button type="button" class="btn-action" style="color: var(--danger);" 
                                            data-id="@p.Id"
                                            data-nombre="@p.Nombre"
                                            onclick="eliminarProductoAsincrono(this)">
                                        Eliminar
                                    </button>
                                }
                                else
                                {
                                    <span style="color: var(--ink-faint); font-size: 0.8rem;">Solo lectura</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

</div>

<div id="modalProducto" class="modal-overlay-custom" onclick="if(event.target === this) cerrarModal();">
    <div class="modal-box-custom">
        <h3 id="modalTitulo" style="margin-bottom: 20px;">Agregar Producto</h3>

        <form id="formProducto" asp-action="Guardar" method="post" onsubmit="guardarProductoAsincrono(event)">
            @Html.AntiForgeryToken()
            <input type="hidden" id="prodId" name="Id" value="0" />
            <input type="hidden" id="prodProveedorId" name="ProveedorId" value="" />

            <div class="form-group" style="margin-bottom: 14px;">
                <label>Nombre del producto *</label>
                <input type="text" id="prodNombre" name="Nombre" class="form-control-custom" 
                       placeholder="Ej. Agua purificada 600 ml" minlength="3" maxlength="100" required />
            </div>

            <div class="form-group" style="margin-bottom: 14px;">
                <label>Categoría *</label>
                <select id="prodCategoria" name="CategoriaId" class="form-control-custom" required>
                    @foreach (var cat in categorias)
                    {
                        <option value="@cat.Id">@cat.Nombre</option>
                    }
                </select>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px;">
                <div class="form-group">
                    <label>Costo de compra ($) *</label>
                    <input type="number" step="0.01" min="0.01" max="100000" id="prodCosto" name="Costo" 
                           class="form-control-custom" placeholder="0.30" required />
                </div>
                <div class="form-group">
                    <label>Precio de venta ($) *</label>
                    <input type="number" step="0.01" min="0.01" max="100000" id="prodPrecio" name="Precio" 
                           class="form-control-custom" placeholder="0.50" required />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 24px;">
                <div class="form-group">
                    <label>Stock actual *</label>
                    <input type="number" step="1" min="0" max="100000" id="prodStock" name="Stock" 
                           class="form-control-custom" value="10" required />
                </div>
                <div class="form-group">
                    <label>Stock mínimo (Alerta) *</label>
                    <input type="number" step="1" min="1" max="10000" id="prodStockMin" name="StockMinimo" 
                           class="form-control-custom" value="5" required />
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn-cancel-custom" onclick="cerrarModal()">Cancelar</button>
                <button type="submit" class="btn-primary-custom" style="background: var(--ink);">Guardar Producto</button>
            </div>
        </form>
    </div>
</div>

<script>
    function abrirModalNuevo() {
        document.getElementById('modalTitulo').innerText = 'Agregar Producto';
        document.getElementById('prodId').value = '0';
        document.getElementById('prodProveedorId').value = '';
        document.getElementById('prodNombre').value = '';
        document.getElementById('prodCosto').value = '';
        document.getElementById('prodPrecio').value = '';
        document.getElementById('prodStock').value = '10';
        document.getElementById('prodStockMin').value = '5';
        document.getElementById('modalProducto').style.display = 'flex';
    }

    function abrirModalEditar(btn) {
        document.getElementById('modalTitulo').innerText = 'Editar Producto';
        document.getElementById('prodId').value = btn.getAttribute('data-id');
        document.getElementById('prodProveedorId').value = btn.getAttribute('data-provid') || '';
        document.getElementById('prodNombre').value = btn.getAttribute('data-nombre');
        document.getElementById('prodCategoria').value = btn.getAttribute('data-catid');
        document.getElementById('prodCosto').value = btn.getAttribute('data-costo');
        document.getElementById('prodPrecio').value = btn.getAttribute('data-precio');
        document.getElementById('prodStock').value = btn.getAttribute('data-stock');
        document.getElementById('prodStockMin').value = btn.getAttribute('data-stockmin');
        document.getElementById('modalProducto').style.display = 'flex';
    }

    function cerrarModal() {
        document.getElementById('modalProducto').style.display = 'none';
    }

    function construirFilaProductoHtml(p) {
        const codigo = 'P-' + String(p.id).padStart(4, '0');
        let estadoTexto = 'Suficiente';
        let estadoClase = 'status-suficiente';
        let barraColor = 'var(--success)';
        let porcentaje = p.stockMinimo > 0 ? Math.min(100, (p.stock * 100.0) / (p.stockMinimo * 2.5)) : 100;

        if (p.stock === 0) {
            estadoTexto = 'Agotado';
            estadoClase = 'status-agotado';
            barraColor = 'var(--danger)';
            porcentaje = 0;
        } else if (p.stock <= p.stockMinimo) {
            estadoTexto = 'Por agotarse';
            estadoClase = 'status-bajo';
            barraColor = 'var(--warning)';
        }

        const nombreSeguro = escapeHtml(p.nombre);
        const catSegura = escapeHtml(p.categoriaNombre || 'General');

        return `
            <td style="color: var(--ink-soft); font-size: 0.85rem;">${codigo}</td>
            <td style="font-weight: 500;">${nombreSeguro}</td>
            <td>${catSegura}</td>
            <td style="font-weight: 600;">$${Number(p.precio).toFixed(2)}</td>
            <td>
                <div class="stock-bar-wrap">
                    <span>${p.stock} <span style="color: var(--ink-faint); font-size: 0.8rem;">/ mín. ${p.stockMinimo}</span></span>
                    <div class="stock-bar-track">
                        <div class="stock-bar-fill" style="width: ${porcentaje}%; background: ${barraColor};"></div>
                    </div>
                </div>
            </td>
            <td>
                <span class="pill-status ${estadoClase}">${estadoTexto}</span>
            </td>
            <td style="text-align: right;">
                <div style="display: inline-flex; gap: 6px;">
                    <button type="button" class="btn-action"
                            data-id="${p.id}"
                            data-nombre="${nombreSeguro}"
                            data-catid="${p.categoriaId}"
                            data-provid="${p.proveedorId || ''}"
                            data-costo="${Number(p.costo)}"
                            data-precio="${Number(p.precio)}"
                            data-stock="${p.stock}"
                            data-stockmin="${p.stockMinimo}"
                            onclick="abrirModalEditar(this)">
                        Editar
                    </button>
                    <button type="button" class="btn-action" style="color: var(--danger);"
                            data-id="${p.id}"
                            data-nombre="${nombreSeguro}"
                            onclick="eliminarProductoAsincrono(this)">
                        Eliminar
                    </button>
                </div>
            </td>
        `;
    }

    function actualizarContadorProductos(delta) {
        const contador = document.getElementById('contadorProductos');
        if (!contador) return;
        const actual = parseInt(contador.innerText, 10) || 0;
        contador.innerText = Math.max(0, actual + delta);
    }

    async function guardarProductoAsincrono(event) {
        event.preventDefault();

        const id = parseInt(document.getElementById('prodId').value, 10) || 0;
        const provVal = document.getElementById('prodProveedorId').value;
        const selectCat = document.getElementById('prodCategoria');
        const categoriaNombre = selectCat.options[selectCat.selectedIndex]?.text || 'General';

        const payload = {
            id: id,
            nombre: document.getElementById('prodNombre').value.trim(),
            categoriaId: parseInt(selectCat.value, 10),
            proveedorId: provVal ? parseInt(provVal, 10) : null,
            costo: parseFloat(document.getElementById('prodCosto').value),
            precio: parseFloat(document.getElementById('prodPrecio').value),
            stock: parseInt(document.getElementById('prodStock').value, 10),
            stockMinimo: parseInt(document.getElementById('prodStockMin').value, 10)
        };

        const esEdicion = id > 0;
        const url = esEdicion ? `/api/productos/${id}` : '/api/productos';
        const metodo = esEdicion ? 'PUT' : 'POST';

        try {
            const res = await fetch(url, {
                method: metodo,
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': getCsrfToken()
                },
                body: JSON.stringify(payload)
            });

            if (res.status === 401 || res.status === 403) {
                throw new Error('No tienes permisos de Administrador para modificar productos.');
            }

            const data = await res.json();
            if (!res.ok || !data.exito) {
                const detalle = Array.isArray(data.errores) && data.errores.length > 0
                    ? data.errores.join(' ')
                    : (data.mensaje || 'No se pudo guardar el producto.');
                throw new Error(detalle);
            }

            const producto = data.dato;
            if (!producto.categoriaNombre) {
                producto.categoriaNombre = categoriaNombre;
            }

            // Actualización parcial del DOM sin recargar toda la página
            const tbody = document.getElementById('tbodyProductos');
            const filaVacia = document.getElementById('filaSinProductos');
            if (filaVacia) filaVacia.remove();

            if (esEdicion) {
                const fila = document.getElementById(`fila-prod-${producto.id}`);
                if (fila) {
                    fila.innerHTML = construirFilaProductoHtml(producto);
                }
            } else {
                const nuevaFila = document.createElement('tr');
                nuevaFila.id = `fila-prod-${producto.id}`;
                nuevaFila.style.transition = 'all 0.3s ease';
                nuevaFila.innerHTML = construirFilaProductoHtml(producto);
                tbody.appendChild(nuevaFila);
                actualizarContadorProductos(1);
            }

            cerrarModal();
            Swal.fire({
                icon: 'success',
                title: '¡Completado!',
                text: data.mensaje,
                confirmButtonColor: '#1F3A2E',
                timer: 2200
            });
        } catch (err) {
            Swal.fire({
                icon: 'error',
                title: 'Atención',
                text: err.message || 'Error de conexión con la API REST.',
                confirmButtonColor: '#A8432B'
            });
        }
    }

    function eliminarProductoAsincrono(btn) {
        const id = btn.getAttribute('data-id');
        const nombre = btn.getAttribute('data-nombre') || '';

        Swal.fire({
            title: '¿Estás seguro?',
            text: `Deseas eliminar "${nombre}". Esta acción no se puede deshacer.`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#A8432B',
            cancelButtonColor: '#52655A',
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar'
        }).then(async (result) => {
            if (!result.isConfirmed) return;

            try {
                const res = await fetch(`/api/productos/${id}`, {
                    method: 'DELETE',
                    headers: { 'X-CSRF-TOKEN': getCsrfToken() }
                });

                if (res.status === 401 || res.status === 403 || res.redirected) {
                    throw new Error('No tienes permisos de Administrador para eliminar productos.');
                }

                if (res.status === 204 || res.ok) {
                    const fila = document.getElementById(`fila-prod-${id}`);
                    if (fila) {
                        fila.style.opacity = '0';
                        fila.style.transform = 'translateX(-20px)';
                        setTimeout(() => fila.remove(), 300);
                    }
                    actualizarContadorProductos(-1);
                    return;
                }

                const data = await res.json();
                throw new Error(data.mensaje || 'No se pudo eliminar el producto.');
            } catch (err) {
                Swal.fire({
                    icon: 'error',
                    title: 'Atención',
                    text: err.message || 'Error de red al conectar con la API REST.',
                    confirmButtonColor: '#A8432B'
                });
            }
        });
    }
</script>