@model LaTiendita.Application.DTOs.EmpleadoDto
@{
    ViewData["Title"] = "Empleados";
    var empleados = ViewBag.Empleados as IEnumerable<LaTiendita.Domain.Entities.Empleado> ?? new List<LaTiendita.Domain.Entities.Empleado>();
}

<div style="max-width: 950px; margin: 0 auto;">

    <!-- Encabezado de la página -->
    <div style="margin-bottom: 24px;">
        <h1 style="font-size: 2rem; margin: 0 0 6px 0;">Empleados</h1>
        <p style="color: var(--ink-soft); margin: 0;">@empleados.Count() empleados registrados en el sistema</p>
    </div>

    <!-- TARJETA 1: Formulario con Fondo Blanco -->
    <div class="card" style="background: #ffffff; border: 1px solid var(--border); border-radius: 12px; padding: 24px; margin-bottom: 28px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
        <h2 style="font-size: 1.2rem; margin-top: 0; margin-bottom: 20px; font-weight: 600; color: var(--ink);">
            @(Model.Id > 0 ? "Editar empleado" : "Registrar nuevo empleado")
        </h2>

        <form asp-action="Guardar" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: start;">
                <!-- Fila 1: Nombre y Contraseña -->
                <div class="form-group">
                    <label asp-for="Nombre" style="font-weight: 500; margin-bottom: 6px; display: block;">Nombre completo *</label>
                    <input asp-for="Nombre" class="form-control-custom" placeholder="Ej. Roberto Gómez" 
                           pattern="^[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s\.'-]+$" title="Solo se permiten letras y espacios" 
                           maxlength="50" minlength="3" required />
                </div>

                <div class="form-group">
                    <label asp-for="Password" style="font-weight: 500; margin-bottom: 6px; display: block;">
                        Contraseña @(Model.Id > 0 ? "(dejar en blanco para no cambiar)" : "*")
                    </label>
                    <input asp-for="Password" type="password" class="form-control-custom" placeholder="••••••••" 
                           minlength="6" maxlength="30" />
                </div>

                <!-- Fila 2: Correo y Teléfono -->
                <div class="form-group">
                    <label asp-for="Correo" style="font-weight: 500; margin-bottom: 6px; display: block;">Correo electrónico *</label>
                    <input asp-for="Correo" type="email" class="form-control-custom" placeholder="roberto@tiendita.com" 
                           maxlength="60" required />
                </div>

                <div class="form-group">
                    <label asp-for="Telefono" style="font-weight: 500; margin-bottom: 6px; display: block;">Teléfono *</label>
                    <input asp-for="Telefono" type="tel" class="form-control-custom" placeholder="2234-5678" 
                           pattern="^[0-9+ -]{8,15}$" title="Ingrese entre 8 y 15 dígitos numéricos" 
                           maxlength="15" required />
                </div>
            </div>

            <div style="margin-top: 22px; display: flex; gap: 12px; align-items: center;">
                <button type="submit" class="btn btn-primary" style="padding: 10px 24px;">
                    @(Model.Id > 0 ? "Actualizar empleado" : "Registrar empleado")
                </button>
                @if (Model.Id > 0)
                {
                    <a href="/Empleado" class="btn btn-secondary" style="padding: 10px 20px; text-decoration: none;">Cancelar</a>
                }
            </div>
        </form>
    </div>

    <!-- TARJETA 2: Tabla con Fondo Blanco -->
    <div class="card" style="background: #ffffff; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.03); margin-bottom: 40px;">
        <div style="padding: 18px 24px; border-bottom: 1px solid var(--border); background: #ffffff;">
            <h2 style="font-size: 1.2rem; margin: 0; font-weight: 600; color: var(--ink);">Empleados registrados</h2>
        </div>

        <table class="table-custom" style="width: 100%; border-collapse: collapse; background: #ffffff;">
            <thead>
                <tr style="background: var(--surface-accent); text-align: left;">
                    <th style="padding: 14px 20px;">Nombre</th>
                    <th style="padding: 14px 20px;">Teléfono</th>
                    <th style="padding: 14px 20px;">Correo</th>
                    <th style="padding: 14px 20px;">Contraseña</th>
                    <th style="padding: 14px 20px; text-align: right;">Acciones</th>
                </tr>
            </thead>
            <tbody style="background: #ffffff;">
                @if (!empleados.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align: center; color: var(--ink-faint); padding: 32px; background: #ffffff;">
                            No hay empleados registrados aún.
                        </td>
                    </tr>
                }
                @foreach (var emp in empleados)
                {
                    <tr style="border-bottom: 1px solid var(--border); background: #ffffff;">
                        <td style="padding: 14px 20px; font-weight: 500;">@emp.Nombre</td>
                        <td style="padding: 14px 20px;">
                            <a href="tel:@emp.Telefono" style="color: var(--ink); text-decoration: underline;">
                                @emp.Telefono
                            </a>
                        </td>
                        <td style="padding: 14px 20px;">@emp.Correo</td>
                        <td style="padding: 14px 20px; letter-spacing: 2px; color: var(--ink-faint);">••••••••</td>
                        <td style="padding: 14px 20px; text-align: right;">
                            <div style="display: inline-flex; gap: 8px; justify-content: flex-end;">
                                <a href="/Empleado?id=@emp.Id" class="btn-action">Editar</a>
                                
                                <!-- Formulario oculto activado por SweetAlert2 -->
                                <form id="form-del-emp-@emp.Id" asp-action="Eliminar" method="post" style="display: none;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@emp.Id" />
                                </form>

                                <button type="button" class="btn-action" style="color: var(--danger); border-color: rgba(168,67,43,0.3);"
                                        onclick="confirmarEliminacion('form-del-emp-@emp.Id', '@emp.Nombre')">
                                    Eliminar
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>