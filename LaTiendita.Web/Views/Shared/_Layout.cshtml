<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>@ViewData["Title"] - La Tiendita</title>
		<link rel="stylesheet" href="~/css/site.css" />
		<!-- SweetAlert2 CDN -->
		<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	</head>
	<body>
		<aside class="sidebar">
			<div class="brand-logo">
				<h2>La Tiendita</h2>
				<p>¡Tu mejor opción!</p>
			</div>

			<nav style="display: flex; flex-direction: column; gap: 4px;">
				<a href="/" class="nav-link-custom"> Inicio</a>
				<a href="/Venta" class="nav-link-custom"> Ventas</a>
				<a href="/Compra" class="nav-link-custom"> Compras</a>
				<a href="/Producto" class="nav-link-custom"> Productos</a>
				<a href="/Categoria" class="nav-link-custom"> Categorías</a>
				<a href="/Proveedor" class="nav-link-custom"> Proveedores</a>
				<a href="/Movimiento" class="nav-link-custom"> Movimientos</a>
				<a href="/Alerta" class="nav-link-custom"> Alertas</a>

				@if (User.IsInRole("Administrador"))
				{
				<a href="/Reporte" class="nav-link-custom"> Reportes</a>
				<a href="/Empleado" class="nav-link-custom"> Empleados</a>
				}
			</nav>

			<div class="nav-bottom">
				@if (User.Identity?.IsAuthenticated == true)
				{
				<form action="/Account/Logout" method="post" id="logoutForm">
					@Html.AntiForgeryToken()
					<button type="submit" class="nav-link-custom" style="width:100%; border:none; background:none; cursor:pointer;">
						 Cerrar sesión
					</button>
				</form>
				}
				else
				{
				<a href="/Account/Login" class="nav-link-custom"> Iniciar sesión</a>
				}
			</div>
		</aside>

		<div class="main-wrapper">
			<header class="topbar">
				@if (User.Identity?.IsAuthenticated == true)
				{
				<div class="user-chip">
					 <strong>@User.Identity.Name</strong>
					<span style="font-size:0.75rem; color:var(--ink-soft); margin-left:4px;">
						(@(User.IsInRole("Administrador") ? "Administrador" : "Empleado"))
					</span>
				</div>
				}
			</header>

			<main class="content-area">
				@RenderBody()
			</main>
		</div>

		<!-- Scripts Globales de SweetAlert2 -->
		<script>
			function confirmarEliminacion(formId, elementoNombre) {
			Swal.fire({
			title: '¿Estás seguro?',
			text: `Deseas eliminar "${elementoNombre}". Esta acción no se puede deshacer.`,
			icon: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#A8432B',
			cancelButtonColor: '#52655A',
			confirmButtonText: 'Sí, eliminar',
			cancelButtonText: 'Cancelar'
			}).then((result) => {
			if (result.isConfirmed) {
			document.getElementById(formId).submit();
			}
			});
			}
		</script>
		@if (TempData["Exito"] != null)
		{
		<script>
			document.addEventListener("DOMContentLoaded", function() {
			Swal.fire({
			icon: 'success',
			title: '¡Completado!',
			text: '@Html.Raw(TempData["Exito"])',
			confirmButtonColor: '#1F3A2E',
			timer: 2800
			});
			});
		</script>
		}
		@if (TempData["Error"] != null)
		{
		<script>
			document.addEventListener("DOMContentLoaded", function() {
			Swal.fire({
			icon: 'error',
			title: 'Atención',
			text: '@Html.Raw(TempData["Error"])',
			confirmButtonColor: '#A8432B'
			});
			});
		</script>
		}

		@await RenderSectionAsync("Scripts", required: false)
	</body>
</html>