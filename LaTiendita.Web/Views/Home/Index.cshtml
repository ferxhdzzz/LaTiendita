@{
    ViewData["Title"] = "Inicio";

    // Saludo dinámico según la hora
    var hora = DateTime.Now.Hour;
    var saludo = hora < 12 ? "Buenos días" : (hora < 18 ? "Buenas tardes" : "Buenas noches");
    var nombreUsuario = User.Identity?.Name ?? "Usuario";

    // Formatear fecha estilo: Jueves 8, octubre
    var cultura = new System.Globalization.CultureInfo("es-ES");
    var fechaHoyTexto = DateTime.Now.ToString("dddd d, MMMM", cultura);
    fechaHoyTexto = char.ToUpper(fechaHoyTexto[0]) + fechaHoyTexto.Substring(1);

    var totalVentasHoy = (decimal)(ViewBag.TotalVentasHoy ?? 0m);
    var cantidadVentasHoy = (int)(ViewBag.CantidadVentasHoy ?? 0);
    var totalPorReponer = (int)(ViewBag.TotalPorReponer ?? 0);
    var totalVencimientos = (int)(ViewBag.TotalVencimientos ?? 0);
    var totalProductos = (int)(ViewBag.TotalProductos ?? 0);

    var porReponer = ViewBag.PorReponer as IEnumerable<LaTiendita.Domain.Entities.Producto> ?? new List<LaTiendita.Domain.Entities.Producto>();
    var lotesPorVencer = ViewBag.LotesPorVencer as IEnumerable<LaTiendita.Domain.Entities.DetalleCompra> ?? new List<LaTiendita.Domain.Entities.DetalleCompra>();
    var ultimosMovimientos = ViewBag.UltimosMovimientos as IEnumerable<LaTiendita.Domain.Entities.Movimiento> ?? new List<LaTiendita.Domain.Entities.Movimiento>();
}

<style>
    /* Modal emergente centrado para pruebas JWT */
    .modal-overlay-custom {
        position: fixed; inset: 0; background: rgba(31, 58, 46, 0.5);
        display: none; align-items: center; justify-content: center; z-index: 9999;
    }
    .modal-box-custom {
        background: #ffffff; width: 100%; max-width: 580px; border-radius: 14px;
        padding: 26px 30px; box-shadow: 0 20px 50px rgba(0,0,0,0.25); border: 1px solid var(--border);
    }
</style>

<div style="max-width: 1100px; margin: 0 auto;">

    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
        <div>
            <h1 style="font-size: 2.2rem; font-weight: 800; margin: 0 0 4px 0; color: var(--ink);">
                @saludo, @nombreUsuario
            </h1>
            <p style="color: var(--ink-soft); margin: 0; font-size: 1.05rem; font-weight: 500;">
                @fechaHoyTexto
            </p>
        </div>

        <div>
            <button type="button" onclick="abrirModalJwt()" 
                    style="background: #D9A62E; color: #1F3A2E; font-weight: 700; border: none; padding: 11px 20px; border-radius: 10px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; font-size: 0.95rem; box-shadow: 0 4px 12px rgba(217, 166, 46, 0.25);">
                <span></span> Probar Token JWT & API REST
            </button>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; margin-bottom: 28px;">
        
        <div class="card" style="background: #ffffff; border: 1px solid var(--border); border-top: 4px solid var(--accent); border-radius: 14px; padding: 22px 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
            <div style="font-size: 2.1rem; font-weight: 800; color: var(--ink); line-height: 1.1;">
                $@totalVentasHoy.ToString("N2")
            </div>
            <div style="font-size: 0.9rem; color: var(--ink-soft); font-weight: 600; margin-top: 8px;">
                Vendido hoy (@cantidadVentasHoy @(cantidadVentasHoy == 1 ? "venta" : "ventas"))
            </div>
        </div>

        <div class="card" style="background: #ffffff; border: 1px solid var(--border); border-top: 4px solid var(--accent); border-radius: 14px; padding: 22px 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
            <div style="font-size: 2.1rem; font-weight: 800; color: var(--ink); line-height: 1.1;">
                @totalPorReponer
            </div>
            <div style="font-size: 0.9rem; color: var(--ink-soft); font-weight: 600; margin-top: 8px;">
                Productos por reponer
            </div>
        </div>

        <div class="card" style="background: #ffffff; border: 1px solid var(--border); border-top: 4px solid var(--accent); border-radius: 14px; padding: 22px 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
            <div style="font-size: 2.1rem; font-weight: 800; color: @(totalVencimientos > 0 ? "var(--danger)" : "var(--ink)"); line-height: 1.1;">
                @totalVencimientos
            </div>
            <div style="font-size: 0.9rem; color: var(--ink-soft); font-weight: 600; margin-top: 8px;">
                Lotes vencidos o por vencer
            </div>
        </div>

        <div class="card" style="background: #ffffff; border: 1px solid var(--border); border-top: 4px solid var(--accent); border-radius: 14px; padding: 22px 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
            <div style="font-size: 2.1rem; font-weight: 800; color: var(--ink); line-height: 1.1;">
                @totalProductos
            </div>
            <div style="font-size: 0.9rem; color: var(--ink-soft); font-weight: 600; margin-top: 8px;">
                Productos en catálogo
            </div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 28px;">
        
        <div class="card" style="background: #ffffff; border: 1px solid var(--border); border-radius: 14px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
            <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0 0 18px 0; color: var(--ink);">
                Por reponer
            </h2>

            @if (!porReponer.Any())
            {
                <div style="text-align: center; color: var(--ink-faint); padding: 30px; font-weight: 500;">
                    Todo el inventario tiene existencias suficientes.
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    @foreach (var p in porReponer)
                    {
                        <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid var(--surface-2);">
                            <span style="font-weight: 600; color: var(--ink); font-size: 0.95rem;">@p.Nombre</span>
                            @if (p.Stock <= 0)
                            {
                                <span style="background: var(--danger-bg); color: var(--danger); font-size: 0.8rem; font-weight: 700; padding: 4px 10px; border-radius: 999px;">
                                    Agotado
                                </span>
                            }
                            else
                            {
                                <span style="background: var(--warning-bg); color: var(--warning); font-size: 0.8rem; font-weight: 700; padding: 4px 10px; border-radius: 999px;">
                                    Quedan @p.Stock
                                </span>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="card" style="background: #ffffff; border: 1px solid var(--border); border-radius: 14px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
            <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0 0 18px 0; color: var(--ink);">
                Vencimientos
            </h2>

            @if (!lotesPorVencer.Any())
            {
                <div style="text-align: center; color: var(--ink-faint); padding: 30px; font-weight: 500;">
                    No hay alertas de vencimiento pendientes.
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    @foreach (var lote in lotesPorVencer)
                    {
                        var fechaVence = lote.FechaVencimiento!.Value.Date;
                        var diasRestantes = (int)(fechaVence - DateTime.UtcNow.Date).TotalDays;
                        var esCritico = diasRestantes <= 3;
                        var bgAlerta = esCritico ? "var(--danger-bg)" : "var(--warning-bg)";
                        var colAlerta = esCritico ? "var(--danger)" : "var(--warning)";
                        var etiquetaVence = diasRestantes < 0
                            ? $"Vencido ({fechaVence:dd-MMM})"
                            : (diasRestantes == 0 ? "Vence hoy" : $"Vence en {diasRestantes} d ({fechaVence:dd-MMM})");

                        <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid var(--surface-2);">
                            <div>
                                <span style="font-weight: 600; color: var(--ink); font-size: 0.95rem;">
                                    @(lote.Producto?.Nombre ?? $"Producto #{lote.ProductoId}")
                                </span>
                                <span style="color: var(--ink-soft); font-size: 0.82rem; margin-left: 4px;">
                                    (Lote: @lote.Cantidad u.)
                                </span>
                            </div>
                            <span style="background: @bgAlerta; color: @colAlerta; font-size: 0.8rem; font-weight: 700; padding: 4px 10px; border-radius: 999px;">
                                @etiquetaVence
                            </span>
                        </div>
                    }
                </div>
            }
        </div>

    </div>

    <div class="card" style="background: #ffffff; border: 1px solid var(--border); border-radius: 14px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.03); margin-bottom: 40px;">
        <div style="padding: 20px 24px; border-bottom: 1px solid var(--border); background: #ffffff;">
            <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0; color: var(--ink);">
                Últimos movimientos
            </h2>
        </div>

        <table class="table-custom" style="width: 100%; border-collapse: collapse; background: #ffffff;">
            <thead>
                <tr style="background: var(--surface-2); text-align: left;">
                    <th style="padding: 14px 20px; font-weight: 700; color: var(--ink);">Fecha</th>
                    <th style="padding: 14px 20px; font-weight: 700; color: var(--ink);">Tipo</th>
                    <th style="padding: 14px 20px; font-weight: 700; color: var(--ink);">Producto</th>
                    <th style="padding: 14px 20px; text-align: right; font-weight: 700; color: var(--ink);">Cantidad</th>
                    <th style="padding: 14px 20px; font-weight: 700; color: var(--ink);">Referencia</th>
                    <th style="padding: 14px 20px; font-weight: 700; color: var(--ink);">Detalle</th>
                    <th style="padding: 14px 20px; font-weight: 700; color: var(--ink);">Usuario</th>
                </tr>
            </thead>
            <tbody style="background: #ffffff;">
                @if (!ultimosMovimientos.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align: center; color: var(--ink-faint); padding: 32px; font-weight: 500;">
                            No hay movimientos recientes registrados.
                        </td>
                    </tr>
                }
                @foreach (var m in ultimosMovimientos)
                {
                    var esSalida = m.Tipo == LaTiendita.Domain.Enums.TipoMovimiento.Salida;
                    <tr style="border-bottom: 1px solid var(--border); background: #ffffff;">
                        <td style="padding: 14px 20px; color: var(--ink-soft); font-size: 0.9rem; font-weight: 500;">
                            @m.Fecha.ToLocalTime().ToString("dd-MMM, h:mm tt")
                        </td>
                        <td style="padding: 14px 20px;">
                            <span style="font-size: 0.78rem; font-weight: 700; padding: 4px 10px; border-radius: 999px; background: @(esSalida ? "var(--surface-2)" : "var(--success-bg)"); color: @(esSalida ? "var(--ink)" : "var(--success)");">
                                @m.Tipo
                            </span>
                        </td>
                        <td style="padding: 14px 20px; font-weight: 600; color: var(--ink);">
                            @(m.Producto?.Nombre ?? $"Producto #{m.ProductoId}")
                        </td>
                        <td style="padding: 14px 20px; text-align: right; font-weight: 700; color: @(esSalida ? "var(--ink)" : "var(--success)");">
                            @(esSalida ? $"-{m.Cantidad}" : $"+{m.Cantidad}")
                        </td>
                        <td style="padding: 14px 20px; color: var(--ink-soft); font-weight: 500;">
                            @(string.IsNullOrWhiteSpace(m.Motivo) ? "—" : m.Motivo)
                        </td>
                        <td style="padding: 14px 20px; color: var(--ink-soft); font-weight: 500;">
                            @(esSalida ? "Venta" : "Compra")
                        </td>
                        <td style="padding: 14px 20px; font-weight: 500; color: var(--ink);">
                            @(m.Empleado?.Nombre ?? "Admin")
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div style="padding: 16px 24px; background: #ffffff; border-top: 1px solid var(--border);">
            <a href="/Movimiento" style="color: var(--ink); font-weight: 700; font-size: 0.9rem; text-decoration: underline;">
                Ver historial completo →
            </a>
        </div>
    </div>

</div>

<div id="modalJwt" class="modal-overlay-custom" onclick="if(event.target === this) cerrarModalJwt();">
    <div class="modal-box-custom">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
            <h3 style="margin: 0; color: var(--ink); font-size: 1.25rem; font-weight: 800;">
                 Probador de Seguridad JWT & API REST
            </h3>
            <button type="button" onclick="cerrarModalJwt()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--ink-soft); line-height: 1;">&times;</button>
        </div>

        <div style="background: #F8F9FA; border: 1px solid var(--border); border-radius: 10px; padding: 14px; margin-bottom: 14px;">
            <div style="font-weight: 700; margin-bottom: 8px; color: var(--ink); font-size: 0.88rem;">
                1. Autenticación y Generación de Token JWT (POST /api/auth/login)
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px;">
                <div>
                    <label style="font-size: 0.75rem; color: var(--ink-soft); font-weight: 600; display: block; margin-bottom: 4px;">Correo:</label>
                    <input type="email" id="jwtEmail" class="form-control-custom" value="admin@tiendita.com" style="padding: 6px 10px; font-size: 0.85rem; width: 100%; box-sizing: border-box;" />
                </div>
                <div>
                    <label style="font-size: 0.75rem; color: var(--ink-soft); font-weight: 600; display: block; margin-bottom: 4px;">Contraseña:</label>
                    <input type="password" id="jwtPassword" class="form-control-custom" value="admin123" style="padding: 6px 10px; font-size: 0.85rem; width: 100%; box-sizing: border-box;" />
                </div>
            </div>
            <button type="button" class="btn-primary-custom" onclick="obtenerTokenJwt()" style="background: var(--ink); width: 100%; padding: 9px; font-size: 0.85rem; cursor: pointer; border: none; border-radius: 8px; color: #fff; font-weight: 700;">
                Obtener Token JWT
            </button>

            <div id="jwtTokenBox" style="display: none; margin-top: 10px;">
                <div style="background: #E4EFE3; color: #3C6E47; padding: 6px 10px; border-radius: 6px; font-size: 0.78rem; font-weight: 600; margin-bottom: 6px; display: flex; justify-content: space-between;">
                    <span> HTTP 200 OK: Token JWT generado</span>
                    <span id="jwtRolBadge">Rol: Administrador</span>
                </div>
                <textarea id="jwtTokenDisplay" class="form-control-custom" rows="2" readonly style="font-family: monospace; font-size: 0.72rem; background: #fff; width: 100%; box-sizing: border-box;"></textarea>
            </div>
        </div>

        <div style="background: #F8F9FA; border: 1px solid var(--border); border-radius: 10px; padding: 14px; margin-bottom: 18px;">
            <div style="font-weight: 700; margin-bottom: 6px; color: var(--ink); font-size: 0.88rem;">
                2. Pruebas de Autorización en Endpoint Protegido (GET /api/auth/perfil)
            </div>
            <p style="font-size: 0.78rem; color: var(--ink-soft); margin-bottom: 10px;">Requiere atributo <code>[Authorize]</code> y esquema <code>Bearer</code>.</p>
            <div style="display: flex; gap: 8px; margin-bottom: 10px;">
                <button type="button" class="btn-action" onclick="probarConToken()" style="background: #3C6E47; color: #fff; font-weight: 600; border: none; padding: 7px 14px; font-size: 0.8rem; cursor: pointer; border-radius: 8px;">
                    Probar CON Token (200 OK)
                </button>
                <button type="button" class="btn-action" onclick="probarSinToken()" style="background: #A8432B; color: #fff; font-weight: 600; border: none; padding: 7px 14px; font-size: 0.8rem; cursor: pointer; border-radius: 8px;">
                    Probar SIN Token (401 Unauthorized)
                </button>
            </div>
            <div id="jwtResultadoBox" style="display: none;">
                <div id="jwtStatusBadge" style="margin-bottom: 6px; font-weight: 700; font-size: 0.8rem;"></div>
                <pre id="jwtJsonOutput" style="background: #1F3A2E; color: #EDEFE6; padding: 8px 12px; border-radius: 8px; font-size: 0.72rem; max-height: 100px; overflow-y: auto; margin: 0;"></pre>
            </div>
        </div>

        <div style="display: flex; justify-content: flex-end;">
            <button type="button" class="btn-cancel-custom" onclick="cerrarModalJwt()" style="padding: 8px 18px; border-radius: 8px; cursor: pointer;">Cerrar</button>
        </div>
    </div>
</div>

<script>
    let tokenJwtGlobal = '';

    function abrirModalJwt() {
        document.getElementById('modalJwt').style.display = 'flex';
    }

    function cerrarModalJwt() {
        document.getElementById('modalJwt').style.display = 'none';
    }

    async function obtenerTokenJwt() {
        const email = document.getElementById('jwtEmail').value.trim();
        const pass = document.getElementById('jwtPassword').value;

        try {
            const res = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ correo: email, password: pass })
            });
            const data = await res.json();
            if (res.ok && data.exito) {
                tokenJwtGlobal = data.token;
                document.getElementById('jwtTokenDisplay').value = data.token;
                document.getElementById('jwtRolBadge').innerText = 'Rol: ' + (data.usuario?.rol || 'Administrador');
                document.getElementById('jwtTokenBox').style.display = 'block';
            } else {
                alert(data.mensaje || 'Error al autenticar');
            }
        } catch (err) {
            alert('Error de conexión con /api/auth/login');
        }
    }

    async function probarConToken() {
        if (!tokenJwtGlobal) {
            alert('Primero presiona "Obtener Token JWT" en el paso 1.');
            return;
        }
        const box = document.getElementById('jwtResultadoBox');
        const badge = document.getElementById('jwtStatusBadge');
        const pre = document.getElementById('jwtJsonOutput');

        try {
            const res = await fetch('/api/auth/perfil', {
                headers: { 'Authorization': 'Bearer ' + tokenJwtGlobal }
            });
            const data = await res.json();
            box.style.display = 'block';
            badge.innerHTML = '<span style="color: #3C6E47;"> HTTP 200 OK: Acceso Autorizado mediante JWT</span>';
            pre.innerText = JSON.stringify(data, null, 2);
        } catch (e) {
            badge.innerText = 'Error de conexión';
        }
    }

    async function probarSinToken() {
        const box = document.getElementById('jwtResultadoBox');
        const badge = document.getElementById('jwtStatusBadge');
        const pre = document.getElementById('jwtJsonOutput');

        try {
            const res = await fetch('/api/auth/perfil');
            box.style.display = 'block';
            if (res.status === 401) {
                badge.innerHTML = '<span style="color: #A8432B;"> HTTP 401 Unauthorized: Acceso Denegado (Sin credenciales)</span>';
                pre.innerText = 'El servidor rechazó la petición porque no se adjuntó el encabezado Authorization: Bearer <token>.';
            } else {
                badge.innerText = 'HTTP ' + res.status;
            }
        } catch (e) {
            badge.innerText = 'Error de conexión';
        }
    }
</script>